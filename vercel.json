{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    {
      "source": "/index.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/dashboard.php",
      "destination": "/api/dashboard.php"
    },
    {
      "source": "/recovery.php",
      "destination": "/api/recovery.php"
    },
    {
      "source": "/test.php",
      "destination": "/api/test.php"
    },
    {
      "source": "/",
      "destination": "/api/index.php"
    }
  ]
}
